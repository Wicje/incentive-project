{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A project entity",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "client": { "type": "string" },
        "status": { "type": "string" },
        "canvasContent": { "type": "string" },
        "createdAt": { "type": "string" },
        "ownerId": { "type": "string" }
      },
      "required": ["name", "client", "status"]
    },
    "Task": {
      "title": "Task",
      "description": "A task entity",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "ownerId": { "type": "string" }
      },
      "required": ["projectId", "title", "status"]
    },
    "Log": {
      "title": "Log",
      "description": "A log entity",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "actor": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["projectId", "action", "actor"]
    },
    "Asset": {
      "title": "Asset",
      "description": "An asset entity",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "url": { "type": "string" },
        "type": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["projectId", "url", "type"]
    },
    "Note": {
      "title": "Note",
      "description": "A note entity",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "content"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "An invoice entity",
      "type": "object",
      "properties": {
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "dueDate": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["clientName", "clientEmail", "amount", "status"]
    },
    "Resource": {
      "title": "Resource",
      "description": "A resource entity",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "url": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "url"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Projects"
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Tasks"
    },
    "/logs/{logId}": {
      "schema": { "$ref": "#/entities/Log" },
      "description": "Logs"
    },
    "/assets/{assetId}": {
      "schema": { "$ref": "#/entities/Asset" },
      "description": "Assets"
    },
    "/notes/{noteId}": {
      "schema": { "$ref": "#/entities/Note" },
      "description": "Notes"
    },
    "/invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/Invoice" },
      "description": "Invoices"
    },
    "/resources/{resourceId}": {
      "schema": { "$ref": "#/entities/Resource" },
      "description": "Resources"
    }
  }
}
